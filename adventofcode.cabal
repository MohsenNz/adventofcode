cabal-version:      3.0
name:               adventofcode
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             Mohsen
maintainer:         thelight.mn@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall

executable adventofcode
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.18.2.0,
                      adventofcode
    hs-source-dirs:   app
    default-language: Haskell2010

library
    exposed-modules:  Day1
                      Day2
                      Day4
    hs-source-dirs:   src
    build-depends:    base ^>=4.18.2.0,
    default-language: Haskell2010

test-suite adventofcode-test
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    Day4Tests
    hs-source-dirs:   test
    build-depends:    base ^>=4.18.2.0,
                      HUnit,
                      adventofcode
